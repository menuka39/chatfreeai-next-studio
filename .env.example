# ---- required ----
# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Your public site URL, sent to OpenRouter as HTTP-Referer
SITE_URL=https://chatfreeai.com

# ---- REQUIRED IN PRODUCTION (Vercel / any serverless host) ----
# Without these the daily free limits are NOT enforced: serverless instances
# don't share memory, so every cold start hands out a fresh allowance.
# Free tier at https://upstash.com -> create a Redis DB -> REST section.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxx

# ---- optional ----
# Print real USD cost per generation to the server logs
LOG_MARGIN=0

# ---- auth (Supabase) — required for login, accounts and subscriptions ----
# Create a project at https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- payments (PayPal subscriptions) ----
# https://developer.paypal.com -> My Apps -> create app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=xxxx
PAYPAL_CLIENT_SECRET=xxxx
# ---- everything below is OPTIONAL ----
# The app auto-creates the product, the three billing plans AND the webhook
# through the PayPal API on first use (needs SITE_URL to be your real https
# domain). Set these only if you want to pin specific ids instead:
# PAYPAL_WEBHOOK_ID=xxxx
# PAYPAL_PLAN_STARTER=P-xxxx
# PAYPAL_PLAN_PRO=P-xxxx
# PAYPAL_PLAN_PROMAX=P-xxxx

# Optional: override the OpenRouter base URL (testing / proxying). Leave unset in production.
# OPENROUTER_BASE_URL=https://openrouter.ai

# Optional: override the PayPal API base URL (testing only). Leave unset in production.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: signs provider video URLs so the frame-extraction proxy can't be
# pointed at anything else (SSRF protection). Falls back to OPENROUTER_API_KEY
# if unset — set a dedicated random value in production.
# VIDEO_URL_SECRET=some-long-random-string

# --- Cloudflare Turnstile (bot protection for the guest tier) ---------------
# Guests get free tokens and 3 web searches a day; a search costs us $0.005
# with no revenue behind it. Without this, the only thing separating guests is
# an IP hash and a browser-generated device id, both trivially rotated.
# Leave unset in development — the check is skipped and a warning is logged.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Google Analytics 4 ------------------------------------------------------
# Optional — the site works fine without it. Skipped automatically in local
# `next dev` even if set, so testing on your own machine never inflates the
# real numbers. Not a secret: a GA4 Measurement ID is visible in the page's
# own rendered HTML to any visitor, unlike every other key in this file.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PZCSS9P5TT

# --- Google AdSense ----------------------------------------------------------
# NOT LIVE YET — the value below is a placeholder, not a real publisher id.
# AdSense has to approve the site before a real `ca-pub-…` id exists.
# The code treats any id containing "XXXX" as unconfigured: no ad script
# loads, <AdSlot> renders nothing, and /ads.txt serves an empty body. Replace
# this with the real id after approval and rebuild — nothing else to change.
# Like the GA id, this is not a secret (it's visible in the page's own HTML),
# and it's skipped in local `next dev` regardless — invalid ad impressions
# from a developer refreshing their own pages are a policy violation.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# --- Direct provider keys (all optional) -------------------------------------
# Set one and the models that declare it stop going through OpenRouter and
# call that provider directly. Leave it unset and nothing changes — OpenRouter
# remains the default and the fallback, so removing a key here is enough to
# restore service without a deploy if a provider has an outage.
#
# Requests using web search always stay on OpenRouter: search is its plugin,
# not something the provider APIs offer.
#
# OPENAI_API_KEY=sk-...   (no longer used — chat routes through OpenRouter only)
# DEEPSEEK_API_KEY=sk-...   (no longer used — chat routes through OpenRouter only)
# XAI_API_KEY=xai-...   (no longer used — chat routes through OpenRouter only)
# ANTHROPIC_API_KEY=sk-ant-...   (no longer used — chat routes through OpenRouter only)
# GEMINI_API_KEY=...
#   Also powers Video to Prompt (/tools/video-to-prompt), which is the one
#   feature that calls Google directly rather than going through OpenRouter:
#   it needs Gemini's external-URL file input to read an uploaded clip.
#   Without this key that tool returns 503 and everything else is unaffected.
#
# Ollama is self-hosted and needs somewhere to reach it rather than a key.
# It cannot run on serverless — point this at your own machine or VPS.
# OLLAMA_BASE_URL=http://your-host:11434/v1   (no longer used — chat routes through OpenRouter only)
